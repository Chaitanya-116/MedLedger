# ─────────────────────────────────────────────────────────────────────────────
# MedLedger — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running the server.
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=MedLedger
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True
API_V1_STR=/api/v1

# ── Security & JWT ───────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for development. Switch to PostgreSQL for production:
#   DATABASE_URL=postgresql://user:password@localhost:5432/medledger
DATABASE_URL=sqlite:///./medledger.db

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ── Seed Admin Accounts ─────────────────────────────────────────────────────
# These credentials are used ONLY for initial database seeding on first run.
# Change the passwords before deploying.
ADMIN1_NAME=M. Srinivasa Rao
ADMIN1_EMAIL=srinivasa.rao@medledger.io
ADMIN1_PASSWORD=CHANGE_THIS_PASSWORD

ADMIN2_NAME=M. Chaitanya
ADMIN2_EMAIL=chaitanya@medledger.io
ADMIN2_PASSWORD=CHANGE_THIS_PASSWORD
